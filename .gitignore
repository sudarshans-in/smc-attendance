# ─── Node ────────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── React Native ────────────────────────────────────────────────────────────
.metro-health-check*
*.tsbuildinfo

# ─── Android build artifacts ─────────────────────────────────────────────────
# NOTE: android/ source folder IS tracked — bare React Native project
# Only build output and local config are ignored

android/build/
android/app/build/
android/.gradle/
android/.idea/

# Local SDK path — each developer sets this for their own machine
android/local.properties

# Production signing keystore — NEVER commit
# debug.keystore is intentionally committed (development builds only)
android/app/release.keystore
android/app/*.release.keystore
android/app/smc-karmachari.keystore

# Bundled JS assets (generated during release build)
android/app/src/main/assets/index.android.bundle
android/app/src/main/assets/index.android.bundle.map

# ─── Environment / Secrets ───────────────────────────────────────────────────
.env
.env.*
!.env.example

# ─── Expo leftovers (migrated to bare React Native) ──────────────────────────
.expo/
dist/
web-build/
expo-env.d.ts
.easignore

# ─── iOS (Android-only project) ──────────────────────────────────────────────
ios/

# ─── macOS ───────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ─── Windows ─────────────────────────────────────────────────────────────────
Thumbs.db
Desktop.ini

# ─── IDE ─────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log
logs/

# ─── Claude Code ─────────────────────────────────────────────────────────────
.claude/
